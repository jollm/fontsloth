;;; Commentary:

;; Regenerate test/data/outline-golden.el from the checked-in fixtures:
;;   emacs --batch -L . -l scripts/generate-outline-golden.el
;;
;; Run this only when the fixtures or the intended outline algorithm change,
;; and include the regenerated file in the same commit as the change.

;;; Code:

(require 'cl-lib)
(require 'fontsloth)
(require 'fontsloth-test-util)

(defconst generate-outline-golden--fixtures
  '("fontsloth-test.ttf"
    "fontsloth-test.otf"
    "fontsloth-test.woff"
    "IBMPlexSerif-Regular-subset.otf"))

(defun generate-outline-golden--entries ()
  "Return (FIXTURE (GLYPH-ID . HASH) ...) entries for all fixtures."
  (let (entries)
    (dolist (name generate-outline-golden--fixtures)
      (let* ((path (fontsloth-test--fixture-font name))
             (font (fontsloth-load-font path :cache 'bypass))
             (glyphs (fontsloth-font-glyphs font))
             (pairs (cl-loop
                     for (glyph-id . _signature)
                     in (fontsloth-test--outline-signatures font)
                     collect (cons glyph-id
                                   (fontsloth-test--glyph-hash
                                    (aref glyphs glyph-id))))))
        (push (cons name pairs) entries)))
    (nreverse entries)))

(defun generate-outline-golden--write ()
  "Write test/data/outline-golden.el."
  (make-directory "test/data" t)
  (with-temp-file "test/data/outline-golden.el"
    (insert ";;; outline-golden.el --- Generated outline hashes -*- lexical-binding: t -*-\n\n")
    (insert ";;; Generated by scripts/generate-outline-golden.el.  Do not edit by hand.\n\n")
    (insert "(defconst fontsloth-invariant-test--golden\n  '")
    (prin1 (generate-outline-golden--entries) (current-buffer))
    (insert ")\n\n(provide 'outline-golden)\n")))

(generate-outline-golden--write)

(provide 'generate-outline-golden)
;;; generate-outline-golden.el ends here
